# Optional. Adds totals, puck line and extra moneyline prices from The Odds API (https://the-odds-api.com).
ODDS_API_KEY=
# Optional. Regions for The Odds API, comma-separated: us, us2, uk, eu, fr, se, au (us,fr adds French books)
ODDS_API_REGION=us,fr
# Optional. Minutes between Odds API refreshes (each call costs markets × regions credits)
ODDS_API_TTL_MIN=15
# Optional. Where the SQLite database lives (default: ./data/puck-edge.db)
DATABASE_PATH=
# Optional. "fixtures" serves responses from /fixtures instead of the live API (for offline development).
NHL_OFFLINE=
